# Muse platform auth
CONNECTOR_SECRET_KEY=

# Optional local/dev fallback (prefer POST /account/connect per user)
COINDCX_API_KEY=
COINDCX_API_SECRET=

COINDCX_API_BASE_URL=https://api.coindcx.com
